{
  "name": "@local/dsh-artex",
  "version": "0.7.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ARTEX-style dual-graph planner/worker orchestration for DeepSeek Harness",
  "engines": {
    "dsh": ">=0.1.6-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "engine.js",
    "graph-ops.js",
    "reporting.js",
    "session-indexer.js",
    "report.js",
    "runner.js",
    "scheduler.js",
    "analyst.js",
    "usage.js",
    "util.js",
    "graph.js",
    "model.js",
    "views.js",
    "store.js",
    "prompts.js",
    "tools.js",
    "tools-shared.js",
    "tools/*.js",
    "config.js",
    "policy.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/graph-smoke.mjs && node test/engine-smoke.mjs && node test/modes-smoke.mjs && node test/persistence-smoke.mjs && node test/security-smoke.mjs && node test/audit-regressions-smoke.mjs",
    "bench": "node test/prompt-size.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
